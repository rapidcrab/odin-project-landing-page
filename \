body {
	margin: 0;
	display: flex;
	flex-direction: column;
}

.text {
	color: #979ca4;
}

.header {
	display: flex;
	justify-content: space-between;
}

.logo {
	color: #ffffff;
	font-weight: 900;
}

.image {
	width: 300px;
	height: 200px;
	background-color: #e5e7eb;
	display: flex;
	align-items: center;
	justify-content: center;
}

.content {
	display: flex;
	flex-direction: column;
}

.sign-up {
	width: fit-content;
	padding: 8px 32px;
}


ul {
	color: white;
	list-style-type: none;
	display: flex;
	margin: 0;
	padding: 0;
	gap: 20px;
}

.header, .section-one {
	max-width: 2000px;
	background-color: #1f2937;
	padding: 20px 200px;
	display: flex;

}

.title-wrap {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 20px
}
